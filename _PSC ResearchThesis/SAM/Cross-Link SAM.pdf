                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Mirrors crossmark:CrosMarkDomains</pdfaProperty:description>
