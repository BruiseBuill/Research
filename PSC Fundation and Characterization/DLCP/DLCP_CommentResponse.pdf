         <pdfx:ZOTERO_BREF_dt4NBrOIALgp_18>Temperature and Ice Volume Through the Mid-Pleistocene Climate Transition","container-title":"Science","page":"704-709","volume":"337","issue":"6095","source":"CrossRef","DOI":"10.1126/science.1221294","ISSN":"0036-8075, 1095-9203","author":[{"family":"El</pdfx:ZOTERO_BREF_dt4NBrOIALgp_18>
